# Dendritic aspect: television (home-manager class).
{inputs, ...}: {
  flake.modules.homeManager.television = let
    nixvimInput = inputs.nixvim;
  in
    {pkgs, ...}: {
      imports = [];

      programs.television = {
        enable = true;

        enableBashIntegration = false; # ctrl-R is owned by atuin
        channels = {
          files = {
            metadata = {
              name = "files";
              description = "A channel to select files and directories";
            };
            preview.command = "bat -n --color=always '{}'";
            source.command = "fd -L -t f";
          };

          # Tridactyl index: `set.*` settings + `excmd.*` ex commands, from
          # the index generated by modules/home/tridactyl/_parse-config.cjs +
          # _parse-excmds.cjs. The index file is only materialized when
          # my.gui.enable, but television is always-on, so tolerate its
          # absence.
          tridactyl = {
            metadata = {
              name = "tridactyl";
              description = "Tridactyl settings + ex commands (generated index)";
            };
            source.command = ''
              test -f ~/.config/tridactyl/index.json && jq -r 'keys[]' ~/.config/tridactyl/index.json || true
            '';
            preview.command = ''jq -r --arg k '{}' '.[$k] as $o | $o.description, "", (if $o.kind == "excmd" then ("Params: " + ([($o.params // [])[] | .name] | join(", "))) + "   Mode: " + ($o.mode // "") else ("Type: " + (if ($o.type // "") == "" then "n/a" else $o.type end)) + "   Default: " + $o.default end), ("Source: " + $o.source)' ~/.config/tridactyl/index.json | fold -s -w 80'';
          };
        };

        settings = {
        };
      };

      programs.nix-search-tv = {
        enable = true;
        enableTelevisionIntegration = true;

        settings = {
          experimental.options_file = {
            nixvim =
              nixvimInput.packages.${pkgs.stdenv.hostPlatform.system}.options-json
              + /share/doc/nixos/options.json;
          };
        };
      };
    };
}
